{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/my-software-factory/project-backlog.schema.json",
  "title": "ProjectBacklog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "status",
    "approved_at",
    "epics",
    "tasks",
    "generated_at"
  ],
  "properties": {
    "project_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$" },
    "status": { "type": "string", "enum": ["draft", "approved"] },
    "approved_at": { "type": ["string", "null"] },
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["epic_id", "title", "objective", "source_requirements", "features"],
        "properties": {
          "epic_id": { "type": "string", "pattern": "^EPIC-[0-9]{2,}$" },
          "title": { "type": "string", "minLength": 1 },
          "objective": { "type": "string" },
          "source_requirements": { "$ref": "#/$defs/stringArray" },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["feature_id", "title", "source_requirements"],
              "properties": {
                "feature_id": {
                  "type": "string",
                  "pattern": "^FEATURE-[0-9]{2,}\\.[0-9]+$"
                },
                "title": { "type": "string", "minLength": 1 },
                "source_requirements": { "$ref": "#/$defs/stringArray" }
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "backlog_ref",
          "feature_id",
          "title",
          "description",
          "business_objective",
          "actor",
          "functional_requirements",
          "acceptance_criteria",
          "source_requirements",
          "dependencies",
          "constraints",
          "out_of_scope",
          "test_requirements",
          "risk_level",
          "open_questions",
          "blocked_by",
          "readiness",
          "task_type",
          "slug"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^TASK-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          },
          "backlog_ref": { "type": "string", "minLength": 1 },
          "feature_id": {
            "type": "string",
            "pattern": "^FEATURE-[0-9]{2,}\\.[0-9]+$"
          },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "business_objective": { "type": "string" },
          "actor": { "type": ["string", "null"] },
          "functional_requirements": { "$ref": "#/$defs/stringArray" },
          "acceptance_criteria": { "$ref": "#/$defs/stringArray" },
          "source_requirements": { "$ref": "#/$defs/stringArray" },
          "dependencies": { "$ref": "#/$defs/stringArray" },
          "constraints": { "$ref": "#/$defs/stringArray" },
          "out_of_scope": { "$ref": "#/$defs/stringArray" },
          "test_requirements": { "$ref": "#/$defs/stringArray" },
          "risk_level": {
            "type": ["string", "null"],
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", null]
          },
          "open_questions": { "$ref": "#/$defs/stringArray" },
          "blocked_by": { "$ref": "#/$defs/stringArray" },
          "readiness": {
            "type": "string",
            "enum": [
              "DRAFT",
              "NEEDS_CLARIFICATION",
              "BLOCKED",
              "READY",
              "IN_PROGRESS",
              "DONE"
            ]
          },
          "task_type": {
            "type": "string",
            "enum": ["feature", "fix", "refactor", "chore", "docs", "test"]
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
