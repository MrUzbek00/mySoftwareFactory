{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/my-software-factory/security-review.schema.json",
  "title": "SecurityReview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "task_id",
    "branch",
    "base_commit",
    "head_commit",
    "findings",
    "dependency_changes",
    "counts",
    "requires_human_review",
    "generated_at"
  ],
  "properties": {
    "status": { "type": "string", "enum": ["clean", "findings"] },
    "task_id": { "type": "string", "pattern": "^TASK-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
    "branch": { "type": "string", "minLength": 1 },
    "base_commit": { "type": "string", "minLength": 1 },
    "head_commit": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "severity", "file", "line", "evidence"],
        "properties": {
          "rule": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          },
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 0 },
          "evidence": { "type": "string" }
        }
      }
    },
    "dependency_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "added_lines"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "added_lines": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
      "properties": {
        "CRITICAL": { "type": "integer", "minimum": 0 },
        "HIGH": { "type": "integer", "minimum": 0 },
        "MEDIUM": { "type": "integer", "minimum": 0 },
        "LOW": { "type": "integer", "minimum": 0 }
      }
    },
    "requires_human_review": { "type": "boolean" },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
