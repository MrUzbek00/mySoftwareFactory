{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/my-software-factory/pull-request-result.schema.json",
  "title": "PullRequestResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "task_id",
    "branch",
    "base_branch",
    "head_commit",
    "pull_request_number",
    "pull_request_url",
    "draft",
    "created_at"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["created"]
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "branch": {
      "type": "string",
      "pattern": "^(feature|fix|refactor|chore|docs|test)/TASK-[A-Z0-9]+(?:-[A-Z0-9]+)*-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "base_branch": { "type": "string", "minLength": 1 },
    "head_commit": { "type": "string", "minLength": 1 },
    "pull_request_number": { "type": "integer", "minimum": 1 },
    "pull_request_url": { "type": "string", "minLength": 1 },
    "draft": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
