{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/my-software-factory/factory-map-state.schema.json",
  "title": "FactoryMapState",
  "description": "State served by factory-map. Tooling output, not a pipeline artifact contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "fingerprint",
    "mode",
    "repo",
    "factory",
    "lanes",
    "nodes",
    "edges",
    "gates",
    "terminal",
    "tasks",
    "selected_task",
    "warnings",
    "views"
  ],
  "properties": {
    "generated_at": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["repo", "run"] },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string" }
      }
    },
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "path", "intake_applies"],
      "properties": {
        "present": { "type": "boolean" },
        "path": { "type": "string" },
        "intake_applies": { "type": "boolean" }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "key", "header", "color", "conditional", "condition_label"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "key": { "type": "string", "minLength": 1 },
          "header": { "type": "string", "minLength": 1 },
          "color": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
          "conditional": { "type": "boolean" },
          "condition_label": { "type": ["string", "null"] }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lane",
          "scope",
          "optional",
          "read_only",
          "description",
          "subtitle",
          "purpose",
          "failure_conditions",
          "escalation_conditions",
          "chips",
          "build",
          "run"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "lane": { "type": "integer", "minimum": 0 },
          "scope": { "enum": ["project", "task"] },
          "optional": { "type": "boolean" },
          "read_only": { "type": "boolean" },
          "description": { "type": "string" },
          "subtitle": { "type": "string" },
          "purpose": { "type": "string" },
          "failure_conditions": { "type": "array", "items": { "type": "string" } },
          "escalation_conditions": { "type": "array", "items": { "type": "string" } },
          "chips": {
            "type": "array",
            "items": { "enum": ["SCRIPT", "MODEL", "GATE", "OPTIONAL", "READ-ONLY"] }
          },
          "build": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "missing", "tests", "script", "schema", "references"],
            "properties": {
              "status": { "enum": ["built", "partial", "missing"] },
              "missing": { "type": "array", "items": { "type": "string" } },
              "tests": { "type": "array", "items": { "type": "string" } },
              "script": { "type": ["string", "null"] },
              "schema": { "type": ["string", "null"] },
              "references": { "type": "integer", "minimum": 0 }
            }
          },
          "run": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "evidence", "artifact"],
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "active",
                  "passed",
                  "blocked",
                  "skipped",
                  "invalid",
                  "not_applicable"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["file", "field", "value"],
                  "properties": {
                    "file": { "type": ["string", "null"] },
                    "field": { "type": ["string", "null"] },
                    "value": {}
                  }
                }
              },
              "artifact": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "name", "source", "present", "valid", "errors",
                  "modified_at"],
                "properties": {
                  "path": { "type": ["string", "null"] },
                  "name": { "type": ["string", "null"] },
                  "source": { "enum": ["repository", "factory-map", null] },
                  "present": { "type": "boolean" },
                  "valid": { "type": ["boolean", "null"] },
                  "errors": { "type": "array", "items": { "type": "string" } },
                  "modified_at": { "type": ["string", "null"] }
                }
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "kind", "gate", "label"],
        "properties": {
          "source": { "type": ["string", "null"] },
          "target": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["normal", "entry", "evidence", "loop", "terminal"] },
          "gate": { "type": ["string", "null"] },
          "label": { "type": ["string", "null"] }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "source",
          "target",
          "passes_when",
          "artifact",
          "field",
          "expected",
          "status",
          "observed",
          "source_file"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "passes_when": { "type": "string", "minLength": 1 },
          "artifact": { "type": ["string", "null"] },
          "field": { "type": ["string", "null"] },
          "expected": {},
          "status": { "enum": ["passed", "blocked", "pending"] },
          "observed": {},
          "source_file": { "type": ["string", "null"] }
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "tasks": { "type": "array", "items": { "type": "string" } },
    "selected_task": { "type": ["string", "null"] },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "checkpoints",
        "skills",
        "scripts",
        "schemas",
        "artifacts",
        "standards",
        "out_of_scope"
      ],
      "properties": {
        "run": { "type": "object" },
        "checkpoints": { "type": "array", "items": { "type": "object" } },
        "skills": { "type": "array", "items": { "type": "object" } },
        "scripts": { "type": "array", "items": { "type": "object" } },
        "schemas": { "type": "array", "items": { "type": "object" } },
        "artifacts": { "type": "array", "items": { "type": "object" } },
        "standards": { "type": "object" },
        "out_of_scope": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
