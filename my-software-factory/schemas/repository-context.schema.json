{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/my-software-factory/repository-context.schema.json",
  "title": "RepositoryContext",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "repository",
    "stack",
    "architecture",
    "relevant_files",
    "relevant_tests",
    "entrypoints",
    "public_contracts",
    "risks",
    "unknowns",
    "recommended_next_context"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "current_branch", "head_commit"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "current_branch": { "type": "string", "minLength": 1 },
        "head_commit": { "type": "string", "minLength": 1 }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "frameworks", "database", "tooling"],
      "properties": {
        "languages": { "$ref": "#/$defs/stringArray" },
        "frameworks": { "$ref": "#/$defs/stringArray" },
        "database": { "$ref": "#/$defs/stringArray" },
        "tooling": { "$ref": "#/$defs/stringArray" }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "patterns"],
      "properties": {
        "summary": { "type": "string" },
        "patterns": { "$ref": "#/$defs/stringArray" }
      }
    },
    "relevant_files": { "$ref": "#/$defs/stringArray" },
    "relevant_tests": { "$ref": "#/$defs/stringArray" },
    "entrypoints": { "$ref": "#/$defs/stringArray" },
    "public_contracts": { "$ref": "#/$defs/stringArray" },
    "risks": { "$ref": "#/$defs/stringArray" },
    "unknowns": { "$ref": "#/$defs/stringArray" },
    "recommended_next_context": { "$ref": "#/$defs/stringArray" }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
