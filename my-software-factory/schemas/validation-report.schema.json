{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/my-software-factory/validation-report.schema.json",
  "title": "ValidationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "task_id",
    "branch",
    "worktree_path",
    "base_branch",
    "head_commit",
    "checks",
    "diff_summary",
    "ready_for_pull_request",
    "generated_at"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "branch": { "type": "string", "minLength": 1 },
    "worktree_path": { "type": "string", "minLength": 1 },
    "base_branch": { "type": "string", "minLength": 1 },
    "head_commit": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "status",
          "exit_code",
          "duration_seconds",
          "output_tail"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "timeout", "not_run"]
          },
          "exit_code": { "type": ["integer", "null"] },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "output_tail": { "type": "string" }
        }
      }
    },
    "diff_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_changed", "insertions", "deletions"],
      "properties": {
        "files_changed": { "type": "integer", "minimum": 0 },
        "insertions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 }
      }
    },
    "code_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_files", "findings", "counts"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "findings", "not_reviewed"]
        },
        "reviewed_files": { "type": "array", "items": { "type": "string" } },
        "skipped_files": { "type": "array", "items": { "type": "string" } },
        "not_reviewed_reason": { "type": ["string", "null"] },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion", "severity", "file", "detail"],
            "properties": {
              "criterion": {
                "type": "string",
                "enum": [
                  "naming",
                  "function-names",
                  "class-names",
                  "parameter-names",
                  "input-types",
                  "return-types",
                  "nullability",
                  "collection-types",
                  "structured-inputs",
                  "documentation",
                  "variadic-contract",
                  "boolean-names",
                  "constants-enums",
                  "comments",
                  "cohesion",
                  "side-effects",
                  "error-behavior",
                  "domain-language",
                  "framework-conventions"
                ]
              },
              "severity": { "type": "string", "enum": ["BLOCKING", "ADVISORY"] },
              "file": { "type": "string", "minLength": 1 },
              "symbol": { "type": ["string", "null"] },
              "detail": { "type": "string", "minLength": 1 },
              "suggestion": { "type": ["string", "null"] }
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["BLOCKING", "ADVISORY"],
          "properties": {
            "BLOCKING": { "type": "integer", "minimum": 0 },
            "ADVISORY": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "ready_for_pull_request": { "type": "boolean" },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
