{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/my-software-factory/completion-report.schema.json",
  "title": "CompletionReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "task_id",
    "stages",
    "artifacts",
    "inconsistencies",
    "outcome",
    "generated_at"
  ],
  "properties": {
    "status": { "type": "string", "enum": ["complete", "incomplete"] },
    "task_id": { "type": "string", "pattern": "^TASK-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "present", "valid", "errors"],
        "properties": {
          "stage": { "type": "string", "minLength": 1 },
          "present": { "type": "boolean" },
          "valid": { "type": ["boolean", "null"] },
          "errors": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "inconsistencies": { "type": "array", "items": { "type": "string" } },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "validation_status",
        "security_status",
        "pull_request_url",
        "awaiting"
      ],
      "properties": {
        "branch": { "type": ["string", "null"] },
        "validation_status": { "type": ["string", "null"] },
        "security_status": { "type": ["string", "null"] },
        "pull_request_url": { "type": ["string", "null"] },
        "awaiting": { "type": "string", "minLength": 1 }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
