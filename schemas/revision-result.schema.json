{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/software-factory-skills/revision-result.schema.json",
  "title": "RevisionResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "task_id",
    "branch",
    "pull_request_number",
    "pull_request_url",
    "head_commit",
    "feedback_addressed",
    "feedback_declined",
    "commits",
    "pushed",
    "generated_at"
  ],
  "properties": {
    "status": { "type": "string", "enum": ["revised", "blocked"] },
    "task_id": { "type": "string", "pattern": "^TASK-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
    "branch": {
      "type": "string",
      "pattern": "^(feature|fix|refactor|chore|docs|test)/TASK-[A-Z0-9]+(?:-[A-Z0-9]+)*-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "pull_request_number": { "type": "integer", "minimum": 1 },
    "pull_request_url": { "type": "string", "minLength": 1 },
    "head_commit": { "type": "string", "minLength": 1 },
    "feedback_addressed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["thread", "resolution"],
        "properties": {
          "thread": { "type": "string", "minLength": 1 },
          "resolution": { "type": "string", "minLength": 1 }
        }
      }
    },
    "feedback_declined": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["thread", "reason"],
        "properties": {
          "thread": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha", "message"],
        "properties": {
          "sha": { "type": "string", "minLength": 7 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pushed": { "type": "boolean" },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
