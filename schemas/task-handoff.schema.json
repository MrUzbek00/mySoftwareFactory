{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/software-factory-skills/task-handoff.schema.json",
  "title": "TaskHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "backlog_ref",
    "project_id",
    "task_title",
    "task_description",
    "task_type",
    "task_slug",
    "repository",
    "acceptance_criteria",
    "constraints",
    "dependencies",
    "out_of_scope",
    "test_requirements",
    "source_requirements",
    "source_specifications",
    "optional_target_paths",
    "risk_level",
    "readiness",
    "open_dependencies",
    "generated_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "backlog_ref": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$" },
    "task_title": { "type": "string", "minLength": 1 },
    "task_description": { "type": "string", "minLength": 1 },
    "task_type": {
      "type": "string",
      "enum": ["feature", "fix", "refactor", "chore", "docs", "test"]
    },
    "task_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "path", "base_branch", "project_type"],
      "properties": {
        "url": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "base_branch": { "type": ["string", "null"] },
        "project_type": {
          "type": "string",
          "enum": ["greenfield", "existing", "unknown"]
        }
      }
    },
    "acceptance_criteria": { "$ref": "#/$defs/nonEmptyStringArray" },
    "constraints": { "$ref": "#/$defs/stringArray" },
    "dependencies": { "$ref": "#/$defs/stringArray" },
    "out_of_scope": { "$ref": "#/$defs/stringArray" },
    "test_requirements": { "$ref": "#/$defs/stringArray" },
    "source_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "statement", "state", "sources"],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^REQ-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          },
          "statement": { "type": "string", "minLength": 1 },
          "state": {
            "type": "string",
            "enum": ["CONFIRMED", "CLARIFIED", "OPTIONAL"]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "section", "subsection", "page"],
              "properties": {
                "source_id": { "type": "string", "pattern": "^SPEC-[0-9]+$" },
                "section": { "type": ["string", "null"] },
                "subsection": { "type": ["string", "null"] },
                "page": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "source_specifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "location"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^SPEC-[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 }
        }
      }
    },
    "optional_target_paths": { "$ref": "#/$defs/stringArray" },
    "risk_level": {
      "type": ["string", "null"],
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", null]
    },
    "readiness": { "const": "READY" },
    "open_dependencies": { "$ref": "#/$defs/stringArray" },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
